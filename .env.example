# --- App ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-secure-random-key
# Must be a random value of 32+ characters; the app refuses to start otherwise.
# DEBUG=true shows login codes on screen, gives codes to numbers not linked to
# Telegram, and makes the API docs public. Never enable in production.
DEBUG=false
APP_BASE_URL=https://courtpilot.in

# --- Database ---
# docker-compose overrides this to point at its postgres service
DATABASE_URL=postgresql://courtpilot:courtpilot@localhost:5432/courtpilot
# Used by docker-compose for the postgres container
POSTGRES_PASSWORD=courtpilot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram (token from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Set in production to receive updates at POST /webhook/telegram.
# Leave empty in development and run the bot in polling mode instead.
TELEGRAM_WEBHOOK_URL=
# Optional; derived from SECRET_KEY if empty. Allowed: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=
# The bot's @username without the @, shown on the website ("Open @CourtPilotBot").
# Looked up from Telegram automatically if left empty.
TELEGRAM_BOT_USERNAME=

# --- WhatsApp Business (Meta Cloud API) — premium add-on ---
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_COST_PER_MESSAGE_INR=0.80

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CourtPilot <notifications@courtpilot.in>

# --- eCourts polling ---
ECOURTS_POLL_INTERVAL_HOURS=6
ECOURTS_MIN_REPOLL_HOURS=4
ECOURTS_MAX_CONCURRENT=5
ECOURTS_RATE_LIMIT_PER_MINUTE=30
ECOURTS_MOBILE_API_FALLBACK=false

# --- Notification schedule (IST) ---
# Per-user notification_time/digest_day (default 08:00, Monday) drive the
# morning reminders and weekly digest; this sets the 1-day evening reminder.
REMINDER_EVENING_TIME=19:00

# --- Plans ---
# No payment gateway yet: keep false so nobody can switch to a paid plan for free.
ALLOW_PLAN_SELF_UPGRADE=false

# --- Login by SMS code (optional) ---
# Empty = phone login codes go to the user's Telegram. Indian SMS needs DLT
# registration through the provider first.
# SMS_PROVIDER=2factor  -> SMS_API_KEY from 2factor.in, SMS_TEMPLATE = template name (optional)
# SMS_PROVIDER=msg91    -> SMS_API_KEY = MSG91 authkey, SMS_TEMPLATE = OTP template id
SMS_PROVIDER=
SMS_API_KEY=
SMS_TEMPLATE=

# --- "Continue with Google" (optional) ---
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorised redirect URI: {APP_BASE_URL}/login/google/callback
# Google requires https on a real domain (an IP address like http://1.2.3.4 is refused).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
